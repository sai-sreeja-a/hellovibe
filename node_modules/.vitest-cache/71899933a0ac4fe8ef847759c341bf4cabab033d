function customMap(array, callback) {
	// Create an array with the same length
	const result = new Array(array.length);
	for (let i = 0; i < array.length; i++) {
		// Check whether this index exists
		if (i in array) {
			result[i] = callback(array[i], i, array);
		}
	};
	return result;
}

